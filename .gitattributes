# Normaliza los finales de línea en el repositorio.
* text=auto eol=lf

# Scripts y configuración siempre LF.
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.tsv     text eol=lf
*.tex     text eol=lf
*.java    text eol=lf
*.ts      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Windows.
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binarios: sin conversión ni diff textual.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.ico     binary
*.svg     text eol=lf

# El informe académico y el backlog se marcan para diff legible.
*.tsv     diff
