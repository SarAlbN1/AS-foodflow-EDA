# ============================================================================
#  FoodFlow EDA — plantilla de variables de entorno
# ============================================================================
#  Copia este archivo como `.env` en la raíz del repositorio y reemplaza cada
#  contraseña de ejemplo por una propia:
#
#      cp .env.example .env
#
#  NUNCA se versiona un `.env` real ni una credencial verdadera
#  (docs/wiki/04-implementacion/convenciones.md). `.gitignore` ya excluye `.env`.
#
#  Regla arquitectónica 2: cada servicio es el único propietario de su base.
#  Por eso cada base tiene usuario y contraseña propios, y a cada servicio se le
#  pasa únicamente la URL de SU base. Nunca reutilices credenciales entre bases.
#
#  Versiones de las imágenes: docs/wiki/04-implementacion/versiones.md
# ============================================================================

# --- Versiones de imágenes (docs/wiki/04-implementacion/versiones.md) -------
# Sin `latest`: etiquetas fijas.
POSTGRES_IMAGE=postgres:18.6
KAFKA_IMAGE=apache/kafka:4.3.1

# --- Kafka (modo KRaft, sin ZooKeeper) --------------------------------------
# Escucha interna, la que usan los servicios dentro de la red de Compose.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Escucha externa, para herramientas ejecutadas en el host (kcat, consola).
KAFKA_HOST_PORT=29092
KAFKA_CLUSTER_ID=foodflow-eda-cluster-01
# Nombres de los tópicos. Los servicios los leen de configuración, nunca como literales
# dispersos en el código (regla arquitectónica 11). Los crea infrastructure/kafka/scripts.
ORDERS_TOPIC=orders.events

# --- Order DB — la usa ÚNICAMENTE order-service -----------------------------
ORDER_DB_NAME=orderdb
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=cambia-esta-clave-order
ORDER_DB_HOST_PORT=5433

# --- Payment DB — la usa ÚNICAMENTE payment-service -------------------------
PAYMENT_DB_NAME=paymentdb
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=cambia-esta-clave-payment
PAYMENT_DB_HOST_PORT=5434
# URL JDBC que recibe ÚNICAMENTE payment-service (regla arquitectónica 2). Desde el host se usa
# localhost y el puerto publicado; dentro de la red de Compose sería
# jdbc:postgresql://payment-db:5432/paymentdb.
PAYMENT_DB_URL=jdbc:postgresql://localhost:5434/paymentdb
# Puerto HTTP local de payment-service. No publica API de negocio: solo el health check.
PAYMENT_SERVICE_PORT=8082
# Grupo de consumidores propio de payment-service sobre orders.events (HU-201).
# Formato <servicio>.<tópico> del contrato de eventos.
PAYMENT_ORDERS_CONSUMER_GROUP=payment-service.orders

# --- Notification DB — la usa ÚNICAMENTE notification-service ---------------
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=cambia-esta-clave-notification
NOTIFICATION_DB_HOST_PORT=5435

# --- Proveedor de notificaciones (mock, HU-306) — lo usa ÚNICAMENTE notification-service
# URL que recibe notification-service dentro de la red de Compose.
NOTIFICATION_PROVIDER_URL=http://notification-provider:8080
# Puerto en el host, solo para probar el mock con curl.
NOTIFICATION_PROVIDER_HOST_PORT=8090
# Espera de *@slow.test; debe superar el timeout de lectura del cliente (3 s).
MOCK_SLOW_DELAY=5s
# Intentos que fallan por destino *@flaky.test antes de responder éxito.
MOCK_FLAKY_FAILURES=2
