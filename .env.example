# Plantilla de variables de entorno de FoodFlow EDA.
# Copia este archivo como `.env` y reemplaza cada valor de ejemplo.
# NUNCA se versiona un `.env` real ni credenciales verdaderas (docs/wiki/04-implementacion/convenciones.md).
#
# Estado: esqueleto del bootstrap. La HU-002 lo completa con la infraestructura local.

# --- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Order DB (solo Order Service) ---------------------------------------
ORDER_DB_NAME=orderdb
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=cambia-esta-clave

# --- Payment DB (solo Payment Service) -----------------------------------
PAYMENT_DB_NAME=paymentdb
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=cambia-esta-clave

# --- Notification DB (solo Notification Service) -------------------------
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=cambia-esta-clave
