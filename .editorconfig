# Convenciones de formato del repositorio (docs/wiki/04-implementacion/convenciones.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[*.{md,tex}]
trim_trailing_whitespace = false

[*.tsv]
indent_style = tab
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
