<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Versiones: docs/wiki/04-implementacion/versiones.md -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.foodflow</groupId>
    <artifactId>order-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>order-service</name>
    <description>FoodFlow Order Service</description>

    <properties>
        <java.version>25</java.version>
        <!-- Guardas de arquitectura (HU-006): docs/wiki/04-implementacion/versiones.md -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <!-- Servidor web: expone el health endpoint de Actuator (HU-604). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Publicacion en orders.events (HU-103). Solo infrastructure.messaging lo usa.
             Es el starter y no spring-kafka a secas: en Spring Boot 4 la configuracion
             automatica de Kafka vive en su propio modulo, y sin ella el productor no se
             configura y las propiedades spring.kafka.* se ignoran. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reglas arquitectonicas ejecutables (HU-006). Solo pruebas. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Kafka y PostgreSQL efimeros para las pruebas de integracion (HU-011, opcional).
             Version gestionada por Spring Boot (testcontainers-bom). Solo se usan con -Ptestcontainers. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- HU-011: ./mvnw verify -Ptestcontainers ejecuta las pruebas de integracion contra un Kafka
             y un PostgreSQL efimeros, creados y destruidos en cada ejecucion. Las variables de entorno
             solo activan las pruebas (@EnabledIfEnvironmentVariable): las direcciones reales las pone
             InfraestructuraEfimera. Sin el perfil, todo funciona como antes (Compose o nada). -->
        <profile>
            <id>testcontainers</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <foodflow.testcontainers>true</foodflow.testcontainers>
                            </systemPropertyVariables>
                            <environmentVariables>
                                <KAFKA_BOOTSTRAP_SERVERS>testcontainers</KAFKA_BOOTSTRAP_SERVERS>
                                <ORDER_DB_URL>testcontainers</ORDER_DB_URL>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
